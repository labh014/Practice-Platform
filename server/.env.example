# ---------------------------------------------------------------------------
# LLD Practice Platform - server configuration
#
# Every value below is OPTIONAL. With no .env file at all the server boots and
# the complete learner loop works, using the zero-cost offline MockLlmClient.
# ---------------------------------------------------------------------------

PORT=4000

# Which LLM provider drives semantic evaluation.
#   mock   - offline, deterministic, no API key, no cost           (default)
#   gemini - Google Gemini, free tier, no credit card required
#   openai - OpenAI, paid per token
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
# Model names change; if you get HTTP 404 the error names the current one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# If a provider is selected but its key is missing, the server logs a warning
# and falls back to the mock client rather than failing to boot.
